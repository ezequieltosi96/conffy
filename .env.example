# Copy to .env to override docker-compose defaults. Never commit .env.
# AI providers (see docs/CONTRACTS.md)
ASR_PROVIDER=whispercpp
ASR_URL=http://host.docker.internal:8081
MT_PROVIDER=openai_compat
MT_URL=http://host.docker.internal:11434/v1
MT_MODEL=gemma4:e4b
# Only for hosted providers:
MT_API_KEY=

# Fake models (ASR_PROVIDER=replay / MT_PROVIDER=replay): simulated latency
REPLAY_ASR_LATENCY_MS=600
REPLAY_MT_LATENCY_MS=1200
